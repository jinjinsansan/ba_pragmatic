# ユーザー認証情報 (GUIセットアップ画面で入力・自動保存)
STAKE_USERNAME=
STAKE_PASSWORD=
LAPLACE_ACCOUNT_EMAIL=

# LAPLACE設定
LAPLACE_MODE=normal
LAPLACE_FIXED_TABLE=
LAPLACE_USER=user

# VPS接続
LAPLACE_USE_REMOTE=1
LAPLACE_API_URL=http://127.0.0.1:8000
# ★2026-09-12: ここに実キーが直書きされていた (2026-04-15 の初回コミット以来)。
#   .dist は配布用の雛形なので値は持たせない。当該キーは履歴に残っているため要ローテーション。
LAPLACE_API_KEY=
# 旧VPS 210.131.215.116 は 2026-08 に解約済み (Xserver が別契約者へ再割当するため空欄が正)。
# 新しい踏み台を用意したら、その時点の正しい値をここに入れる。
LAPLACE_SSH_HOST=
LAPLACE_LOCAL_PORT=8000
LAPLACE_REMOTE_PORT=8000

# ★Stake オリジン。stake.com は 2026-09 に日本向け HTTP 451。
#   日本向けは https://playstake.io のミラーを指定する (焼かれる度に更新)。
#   運用中の切替はマスターAPIが配る値が優先される。
BACOPY_STAKE_ORIGIN=https://stake.com
